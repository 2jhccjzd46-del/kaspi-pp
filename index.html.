<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Мой Kaspi</title>
    <style>
        :root {
            --kaspi-red: #E41E31;
            --kaspi-gray: #F4F5F7;
            --text-dark: #1A1A1A;
            --text-gray: #7A7A7A;
            --white: #FFFFFF;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
        body { background-color: var(--white); color: var(--text-dark); overflow: hidden; height: 100vh; width: 100vw; }
        .screen {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: var(--white); display: none; flex-direction: column;
            overflow-y: auto; padding-bottom: 80px; z-index: 1;
        }
        .screen.active { display: flex; }
        #pin-screen { justify-content: center; align-items: center; background: var(--white); z-index: 100; }
        .pin-dots { display: flex; gap: 15px; margin-bottom: 30px; }
        .pin-dot { width: 15px; height: 15px; border-radius: 50%; border: 2px solid var(--kaspi-red); }
        .pin-dot.filled { background: var(--kaspi-red); }
        .pin-pad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
        .pin-btn {
            width: 70px; height: 70px; border-radius: 50%; border: none;
            background: var(--kaspi-gray); font-size: 24px; font-weight: 500;
            cursor: pointer; display: flex; justify-content: center; align-items: center;
        }
        .pin-btn:active { background: #ddd; }
        .header { padding: 20px; display: flex; justify-content: space-between; align-items: center; }
        .header h1 { font-size: 20px; }
        .balance-card {
            background: linear-gradient(135deg, #FFD700, #FFA500);
            margin: 0 20px; padding: 20px; border-radius: 15px; color: #333;
            margin-bottom: 20px;
        }
        .balance-card h2 { font-size: 14px; opacity: 0.8; }
        .balance-card .amount { font-size: 28px; font-weight: bold; margin-top: 5px; }
        .menu-grid {
            display: grid; grid-template-columns: repeat(4, 1fr);
            gap: 15px; padding: 0 20px; margin-bottom: 20px;
        }
        .menu-item { display: flex; flex-direction: column; align-items: center; text-align: center; font-size: 12px; cursor: pointer; }
        .menu-icon {
            width: 50px; height: 50px; background: var(--kaspi-gray); border-radius: 12px;
            display: flex; justify-content: center; align-items: center; margin-bottom: 5px; font-size: 24px;
        }
        .btn {
            background: var(--kaspi-red); color: white; border: none;
            padding: 15px; border-radius: 10px; font-size: 16px; font-weight: 600;
            width: 100%; cursor: pointer; margin-top: 10px;
        }
        .btn:active { opacity: 0.8; }
        .input-group { margin-bottom: 15px; padding: 0 20px; }
        .input-group label { display: block; font-size: 14px; color: var(--text-gray); margin-bottom: 5px; }
        .input-group input {
            width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 8px; font-size: 16px;
        }
        .input-group input:focus { outline: none; border-color: var(--kaspi-red); }
        .bottom-nav {
            position: fixed; bottom: 0; left: 0; width: 100%;
            background: var(--white); border-top: 1px solid #eee;
            display: flex; justify-content: space-around; padding: 10px 0; z-index: 50;
        }
        .nav-item { display: flex; flex-direction: column; align-items: center; font-size: 10px; color: var(--text-gray); cursor: pointer; }
        .nav-item.active { color: var(--kaspi-red); }
        .nav-item span { font-size: 20px; margin-bottom: 2px; }
        .back-btn { font-size: 24px; cursor: pointer; padding: 10px; }
        .doc-tabs { display: flex; margin: 20px; border: 1px solid #ddd; border-radius: 8px; overflow: hidden; }
        .doc-tab { flex: 1; padding: 12px; text-align: center; cursor: pointer; background: var(--white); }
        .doc-tab.active { background: var(--kaspi-red); color: white; }
        .file-upload {
            margin: 20px; padding: 20px; border: 2px dashed #ddd; border-radius: 10px;
            text-align: center; color: var(--text-gray); cursor: pointer;
        }
        .file-upload input { display: none; }
        .file-preview { max-width: 100%; max-height: 200px; margin-top: 10px; border-radius: 8px; }
        .history-item {
            display: flex; justify-content: space-between; padding: 15px 20px; border-bottom: 1px solid #eee;
        }
        .history-item .info { display: flex; flex-direction: column; }
        .history-item .info span:first-child { font-weight: 600; }
        .history-item .info span:last-child { font-size: 12px; color: var(--text-gray); }
        .history-item .amount { font-weight: 600; color: var(--kaspi-red); }
        .hidden { display: none !important; }
        .contact-item { padding: 15px; border-bottom: 1px solid #eee; cursor: pointer; }
        .contact-item:active { background: #f9f9f9; }
    </style>
</head>
<body>
    <div id="pin-screen" class="screen active">
        <div class="pin-dots">
            <div class="pin-dot" id="dot1"></div><div class="pin-dot" id="dot2"></div>
            <div class="pin-dot" id="dot3"></div><div class="pin-dot" id="dot4"></div>
        </div>
        <div class="pin-pad">
            <button class="pin-btn" onclick="enterPin(1)">1</button>
            <button class="pin-btn" onclick="enterPin(2)">2</button>
            <button class="pin-btn" onclick="enterPin(3)">3</button>
            <button class="pin-btn" onclick="enterPin(4)">4</button>
            <button class="pin-btn" onclick="enterPin(5)">5</button>
            <button class="pin-btn" onclick="enterPin(6)">6</button>
            <button class="pin-btn" onclick="enterPin(7)">7</button>
            <button class="pin-btn" onclick="enterPin(8)">8</button>
            <button class="pin-btn" onclick="enterPin(9)">9</button>
            <button class="pin-btn" onclick="clearPin()">X</button>
            <button class="pin-btn" onclick="enterPin(0)">0</button>
            <button class="pin-btn" onclick="deletePin()">⌫</button>
        </div>
        <p style="margin-top: 20px; color: #999; font-size: 14px;">Введите код для доступа</p>
    </div>

    <div id="main-screen" class="screen">
        <div class="header"><h1>Мой Kaspi</h1><div style="font-size: 20px;">👤</div></div>
        <div class="balance-card">
            <h2>Kaspi Gold</h2>
            <div class="amount" id="main-balance">0 ₸</div>
            <div style="font-size: 12px; margin-top: 5px;">Доступно</div>
        </div>
        <div class="menu-grid">
            <div class="menu-item" onclick="showScreen('my-bank-screen')"><div class="menu-icon">🏦</div><span>Мой Банк</span></div>
            <div class="menu-item" onclick="showScreen('transfers-screen')"><div class="menu-icon">💸</div><span>Переводы</span></div>
            <div class="menu-item" onclick="showGovServices()"><div class="menu-icon">🏛️</div><span>Госуслуги</span></div>
            <div class="menu-item"><div class="menu-icon">📱</div><span>QR</span></div>
        </div>
        <div class="bottom-nav">
            <div class="nav-item active" onclick="showScreen('main-screen')"><span>🏠</span> Главная</div>
            <div class="nav-item"><span>📷</span> QR</div>
            <div class="nav-item"><span>💬</span> Сообщения</div>
            <div class="nav-item"><span>⚙️</span> Сервисы</div>
        </div>
    </div>

    <div id="my-bank-screen" class="screen">
        <div class="header"><div class="back-btn" onclick="showScreen('main-screen')">←</div><h1>Мой Банк</h1><div></div></div>
        <div style="padding: 20px;">
            <div class="balance-card" style="background: linear-gradient(135deg, #4CAF50, #2E7D32); color: white;">
                <h2>Kaspi Gold *1234</h2>
                <div class="amount" id="bank-balance">0 ₸</div>
                <div style="font-size: 12px; margin-top: 5px;">Доступно</div>
            </div>
            <div class="input-group" style="margin-top: 20px;">
                <label>Изменить сумму на счете</label>
                <input type="number" id="input-amount" placeholder="Например: 50000" oninput="updateBalance(this.value)">
            </div>
            <div class="input-group">
                <label>Имя владельца</label>
                <input type="text" id="input-name" placeholder="Введите имя" oninput="updateName(this.value)">
            </div>
            <button class="btn" onclick="showScreen('main-screen')">Назад</button>
        </div>
    </div>

    <div id="gov-loading" class="screen" style="justify-content: center; align-items: center; background: #fff;">
        <div style="font-size: 60px; margin-bottom: 20px;">🇰🇿</div>
        <h2>eGov + Kaspi</h2>
        <p style="color: #999; margin-top: 10px;">Загрузка...</p>
    </div>

    <div id="gov-menu-screen" class="screen">
        <div class="header"><div class="back-btn" onclick="showScreen('main-screen')">←</div><h1>Госуслуги</h1><div></div></div>
        <div style="padding: 20px;">
            <div class="menu-grid" style="grid-template-columns: repeat(2, 1fr);">
                <div class="menu-item" onclick="showScreen('gov-id-screen')" style="padding: 20px; border: 1px solid #eee; border-radius: 10px;">
                    <div class="menu-icon">🆔</div><span>Удостоверение личности</span>
                </div>
                <div class="menu-item" style="padding: 20px; border: 1px solid #eee; border-radius: 10px; opacity: 0.5;">
                    <div class="menu-icon">📄</div><span>Паспорт</span>
                </div>
            </div>
        </div>
    </div>

    <div id="gov-id-screen" class="screen">
        <div class="header"><div class="back-btn" onclick="showScreen('gov-menu-screen')">←</div><h1>Удостоверение</h1><div></div></div>
        <div class="doc-tabs">
            <div class="doc-tab active" onclick="switchTab('doc')">Документ</div>
            <div class="doc-tab" onclick="switchTab('req')">Реквизиты</div>
        </div>
        <div id="tab-doc" style="padding: 20px;">
            <div class="file-upload" onclick="document.getElementById('file-input').click()">
                <span id="file-label">Выбрать файл</span>
                <input type="file" id="file-input" accept="image/*" onchange="previewFile(event)">
                <img id="file-preview" class="file-preview hidden" src="" alt="Превью">
            </div>
            <button class="btn" onclick="alert('Документ предъявлен!')">Предъявить документ</button>
        </div>
        <div id="tab-req" class="hidden" style="padding: 20px;">
            <div class="input-group"><label>ИИН</label><input type="text" placeholder="Введите ИИН"></div>
            <div class="input-group"><label>Номер паспорта</label><input type="text" placeholder="Введите номер"></div>
            <div class="input-group"><label>Дата рождения</label><input type="date"></div>
            <div class="input-group"><label>Дата выдачи</label><input type="date"></div>
            <div class="input-group"><label>Срок действия</label><input type="date"></div>
            <button class="btn" onclick="alert('Реквизиты сохранены!')">Сохранить</button>
        </div>
    </div>

    <div id="transfers-screen" class="screen">
        <div class="header"><div class="back-btn" onclick="showScreen('main-screen')">←</div><h1>Переводы</h1><div></div></div>
        <div class="doc-tabs" style="margin: 10px 20px;">
            <div class="doc-tab active" onclick="switchTransferTab('new')">Новый перевод</div>
            <div class="doc-tab" onclick="switchTransferTab('history')">История</div>
        </div>
        <div id="transfer-new" style="padding: 20px;">
            <div class="input-group">
                <label>Номер телефона или имя</label>
                <input type="text" id="search-contact" placeholder="Введите имя" oninput="searchContacts()">
            </div>
            <div id="contacts-list" style="max-height: 300px; overflow-y: auto; border: 1px solid #eee; border-radius: 8px;">
                <div class="contact-item" onclick="selectContact('Айдар')">Айдар</div>
                <div class="contact-item" onclick="selectContact('Мария')">Мария</div>
                <div class="contact-item" onclick="selectContact('Ерлан')">Ерлан</div>
            </div>
            <div class="input-group" style="margin-top: 15px;">
                <label>Сумма перевода</label>
                <input type="number" id="transfer-amount" placeholder="0 ₸">
            </div>
            <button class="btn" onclick="makeTransfer()">Перевести</button>
        </div>
        <div id="transfer-history" class="hidden">
            <div class="input-group" style="margin-top: 10px;"><label>Дата</label><input type="date" id="history-date"></div>
            <div class="input-group"><label>Сумма</label><input type="number" id="history-amount" placeholder="0 ₸"></div>
            <div class="input-group"><label>Имя получателя</label><input type="text" id="history-name" placeholder="Имя"></div>
            <div class="file-upload" onclick="document.getElementById('history-file').click()">
                <span>Загрузить чек</span>
                <input type="file" id="history-file" accept="image/*">
            </div>
            <div id="history-list" style="margin-top: 20px;">
                <div class="history-item">
                    <div class="info"><span>Kaspi Gold</span><span>Клиенту Kaspi</span></div>
                    <div class="amount">200,00 ₸</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        let currentPin = "";
        const correctPin = "8514";
        function enterPin(num) {
            if (currentPin.length < 4) currentPin += num;
            updateDots();
            if (currentPin.length === 4) checkPin();
        }
        function deletePin() { if (currentPin.length > 0) { currentPin = currentPin.slice(0, -1); updateDots(); } }
        function clearPin() { currentPin = ""; updateDots(); }
        function updateDots() {
            for (let i = 1; i <= 4; i++) {
                const dot = document.getElementById(`dot${i}`);
                if (i <= currentPin.length) dot.classList.add('filled');
                else dot.classList.remove('filled');
            }
        }
        function checkPin() {
            if (currentPin === correctPin) {
                showScreen('main-screen'); currentPin = ""; updateDots();
            } else {
                alert("Неверный пин-код! Попробуйте снова (8514)"); clearPin();
            }
        }
        function showScreen(screenId) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById(screenId).classList.add('active');
        }
        function updateBalance(val) {
            const formatted = new Intl.NumberFormat('ru-RU').format(val) + ' ₸';
            document.getElementById('bank-balance').innerText = formatted;
            document.getElementById('main-balance').innerText = formatted;
        }
        function updateName(val) { console.log("Имя: " + val); }
        function showGovServices() {
            showScreen('gov-loading');
            setTimeout(() => { showScreen('gov-menu-screen'); }, 1500);
        }
        function switchTab(tab) {
            document.querySelectorAll('.doc-tab').forEach(t => t.classList.remove('active'));
            event.target.classList.add('active');
            if (tab === 'doc') {
                document.getElementById('tab-doc').classList.remove('hidden');
                document.getElementById('tab-req').classList.add('hidden');
            } else {
                document.getElementById('tab-doc').classList.add('hidden');
                document.getElementById('tab-req').classList.remove('hidden');
            }
        }
        function previewFile(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('file-preview').src = e.target.result;
                    document.getElementById('file-preview').classList.remove('hidden');
                    document.getElementById('file-label').innerText = "Файл выбран";
                }
                reader.readAsDataURL(file);
            }
        }
        function switchTransferTab(tab) {
            document.querySelectorAll('#transfers-screen .doc-tab').forEach(t => t.classList.remove('active'));
            event.target.classList.add('active');
            if (tab === 'new') {
                document.getElementById('transfer-new').classList.remove('hidden');
                document.getElementById('transfer-history').classList.add('hidden');
            } else {
                document.getElementById('transfer-new').classList.add('hidden');
                document.getElementById('transfer-history').classList.remove('hidden');
            }
        }
        function searchContacts() {
            const query = document.getElementById('search-contact').value.toLowerCase();
            document.querySelectorAll('#contacts-list .contact-item').forEach(item => {
                item.style.display = item.innerText.toLowerCase().includes(query) ? 'block' : 'none';
            });
        }
        function selectContact(name) {
            document.getElementById('search-contact').value = name;
            document.getElementById('contacts-list').style.display = 'none';
        }
        function makeTransfer() {
            const amount = document.getElementById('transfer-amount').value;
            const contact = document.getElementById('search-contact').value;
            if (amount && contact) alert(`Перевод ${amount} ₸ для ${contact} выполнен!`);
            else alert("Заполните все поля!");
        }
    </script>
</body>
</html>